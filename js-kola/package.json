{
  "name": "kola-q",
  "version": "2.5.1",
  "description": "Typed Node.js bindings for q IPC backed by kola",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native.js",
    "native.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "napi build --manifest-path ../bindings/napi-kola/Cargo.toml --package-json-path ./package.json --output-dir . --platform --esm --js native.js --dts native.d.ts",
    "build:native:release": "npm run build:native -- --profile node-release",
    "build:release": "npm run build:native:release && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:native && npm run build:ts",
    "create:npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts --output-dir artifacts --npm-dir npm",
    "prepublishOnly": "node -e \"const fs=require('node:fs'); for (const f of ['native.js','native.d.ts']) if (!fs.existsSync(f)) throw new Error('Missing generated '+f)\" && npm run build:ts && napi prepublish -t npm",
    "pretest": "npm run build:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run test/live-ipc.test.ts",
    "pretest:live": "npm run build:ts",
    "benchmark": "node --expose-gc benchmarks/compare-jkdb.mjs"
  },
  "napi": {
    "binaryName": "kola_q",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "dependencies": {
    "apache-arrow": "^21.0.0"
  },
  "optionalDependencies": {
    "kola-q-win32-x64-msvc": "2.5.1",
    "kola-q-linux-x64-gnu": "2.5.1",
    "kola-q-darwin-arm64": "2.5.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.1",
    "@types/node": "^22.17.0",
    "jkdb": "1.4.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "q",
    "kdb+",
    "arrow",
    "napi-rs"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jshinonome/kola.git",
    "directory": "js-kola"
  },
  "publishConfig": {
    "access": "public"
  }
}
